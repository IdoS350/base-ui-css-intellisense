{
  "name": "base-ui-css-intellisense",
  "packageManager": "pnpm@10.33.0",
  "displayName": "Base UI CSS IntelliSense",
  "description": "Autocomplete and hover docs for Base UI data attributes and CSS variables in CSS, SCSS, and Less files.",
  "version": "0.1.0",
  "publisher": "idos",
  "license": "MIT",
  "icon": "assets/icon-full-res.png",
  "homepage": "https://github.com/IdoS350/base-ui-css-intellisense",
  "repository": {
    "type": "git",
    "url": "https://github.com/IdoS350/base-ui-css-intellisense"
  },
  "bugs": {
    "url": "https://github.com/IdoS350/base-ui-css-intellisense/issues"
  },
  "keywords": [
    "base-ui",
    "css",
    "autocomplete",
    "intellisense",
    "data-attributes"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "css.customData": [
      "./data/base-ui.css-data.json"
    ],
    "configuration": {
      "title": "Base UI CSS IntelliSense",
      "properties": {
        "baseUiIntelliSense.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Base UI CSS IntelliSense. Requires a window reload to take effect."
        },
        "baseUiIntelliSense.packageName": {
          "type": "string",
          "default": "@base-ui/react",
          "description": "The import package name used to identify Base UI component files (e.g. a monorepo alias or fork name)."
        },
        "baseUiIntelliSense.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/out/**",
            "**/releases/**"
          ],
          "description": "Glob patterns to exclude when scanning for JS/TS bridge files."
        },
        "baseUiIntelliSense.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "css",
            "tailwindcss",
            "postcss",
            "scss",
            "less"
          ],
          "description": "Language IDs to activate completions and hover documentation for."
        },
        "baseUiIntelliSense.customResolvers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Function names whose call-site arguments are analyzed for Base UI component + className pairs (e.g. \"styleComponent\", \"withStyles\")."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "mkdir -p releases && vsce package --out releases/",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish $(ls releases/*.vsix | head -1) -p $OVSX_TOKEN",
    "generate": "tsx scripts/generate/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@types/node": "^25.6.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "fast-glob": "^3.3.3",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild",
      "keytar"
    ]
  }
}
