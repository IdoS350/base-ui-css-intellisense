{
  "name": "base-ui-css-intellisense",
  "displayName": "Base UI CSS IntelliSense",
  "description": "Autocomplete and hover docs for Base UI data attributes and CSS variables in CSS, SCSS, and Less files.",
  "version": "0.1.0",
  "publisher": "idos",
  "license": "MIT",
  "icon": "assets/icon.png",
  "homepage": "https://github.com/IdoS350/base-ui-css-intellisense",
  "repository": {
    "type": "git",
    "url": "https://github.com/IdoS350/base-ui-css-intellisense"
  },
  "bugs": {
    "url": "https://github.com/IdoS350/base-ui-css-intellisense/issues"
  },
  "keywords": [
    "base-ui",
    "css",
    "autocomplete",
    "intellisense",
    "data-attributes"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "css.customData": [
      "./data/base-ui.css-data.json"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "mkdir -p releases && vsce package --out releases/",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish $(ls releases/*.vsix | head -1) -p $OVSX_TOKEN",
    "generate": "tsx scripts/generate/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "fast-glob": "^3.3.3",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
